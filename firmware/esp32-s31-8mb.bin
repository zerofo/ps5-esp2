        overflow: hidden;
        text-overflow: ellipsis;
    }
    #top-bar-text {
        margin: 4px 0 0;
        font-size: 15px;
        color: #eaf4ff;
        word-break: break-all;
    }
    .fw-bold { font-weight: 700; color: #fff; }

    /* ============ Toast ============ */
    #toast-container {
        position: absolute; top: 8px; right: 8px;
        z-index: 100; pointer-events: none; max-width: 320px;
    }
    .toast {
        background: rgba(21, 22, 24, 0.95); color: #fff;
        padding: 8px 12px; border-radius: 8px;
        font-size: 14px; line-height: 1.3; word-break: break-all;
        opacity: 0;
        -webkit-transform: translateX(20px);
        transform: translateX(20px);
        -webkit-transition: opacity .3s, -webkit-transform .3s;
        transition: opacity .3s, transform .3s;
        pointer-events: auto;
        box-shadow: 0 4px 16px rgba(0, 128, 255, .5);
    }
    #toast.show { opacity: 1; -webkit-transform: translateX(0); transform: translateX(0); }
    #toast.hide { opacity: 0; -webkit-transform: translateX(20px); transform: translateX(20px); }

    /* ============ ä¸»è§†å›¾ ============ */
    #main-content {
        position: relative;
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
    }
    #main-content > div {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        opacity: 0;
        pointer-events: none;
        -webkit-transition: opacity .3s;
        transition: opacity .3s;
        overflow-y: auto;
        padding: 10px;
    }
    #main-content > div.selected { opacity: 1; pointer-events: auto; }

    /* ============ é¦–å±æŒ‰é’® ============ */
    #pre-jb-view {
        display: -webkit-box; display: -webkit-flex; display: flex;
        -webkit-box-orient: vertical; -webkit-flex-direction: column; flex-direction: column;
        -webkit-box-pack: center; -webkit-justify-content: center; justify-content: center;
        -webkit-box-align: center; -webkit-align-items: center; align-items: center;
    }
    .btn {
        display: inline-block;
        background: -webkit-linear-gradient(top, #0f8aff, #0066cc);
        background: linear-gradient(180deg, #0f8aff, #0066cc);
        color: #fff;
        border: 1px solid #4aa8ff;
        padding: 16px 28px;
        border-radius: 12px;
        font-size: 22px;
        font-weight: 700;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        -webkit-transition: opacity .2s, box-shadow .2s, -webkit-transform .2s;
        transition: opacity .2s, box-shadow .2s, transform .2s;
        min-width: 300px;
        margin: 10px 0;
        box-shadow: 0 4px 16px rgba(0, 128, 255, .35);
    }
    .btn:hover {
        opacity: .95;
        box-shadow: 0 0 20px var(--mainColor), 0 4px 16px rgba(0, 128, 255, .6);
        -webkit-transform: translateY(-1px);
        transform: translateY(-1px);
    }
    .btn:focus { outline: 2px solid #fff; }

    /* ============ ç»ˆç«¯ï¼ˆæ”¶çª„ + å±…ä¸­ï¼‰ ============ */
    #main-content > #console-view {
        left: 0;
        right: 0;
        width: 70%;
        margin-left: auto;
        margin-right: auto;
    }
    #console-view {
        padding: 8px !important;
        display: -webkit-box; display: -webkit-flex; display: flex;
        -webkit-box-orient: vertical; -webkit-flex-direction: column; flex-direction: column;
    }
    .terminaltitle {
        flex: 0 0 auto;
        background: #fff;
        color: #000;
        font-family: monospace;
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 2px;
        text-align: center;
        padding: 6px 10px;
        border-radius: 12px 12px 0 0;
        text-transform: uppercase;
    }
    .log {
        flex: 1 1 auto;
        min-height: 0;
        font-family: "SF Mono", "Consolas", "Courier New", monospace,
                     "SST", "Microsoft YaHei", "PingFang SC",
                     "Noto Sans CJK SC", "Heiti SC", sans-serif;
        font-size: 15px;
        line-height: 1.4;
        white-space: pre-wrap;
        word-break: break-all;
        color: #ddd;
        padding: 10px;
        background: #000;
        border: 1px solid #fff;
        border-top: none;
        border-radius: 0 0 12px 12px;
        overflow-y: auto;
    }
    .LOG-DEBUG   { color: #888; }
    .LOG-INFO    { color: #8cf; }
    .LOG-LOG     { color: #ddd; }
    .LOG-WARN    { color: #fc8; }
    .LOG-ERROR   { color: #f88; }
    .LOG-SUCCESS { color: #8f8; font-weight: 700; }

    /* ============ åº•éƒ¨ msg æ¡ ============ */
    #msgs-wrap {
        flex: 0 0 110px;
        height: 110px;
        position: relative;
        overflow: hidden;
        text-align: center;
        border-top: 1px solid #1a3a5a;
        background: -webkit-radial-gradient(circle at center, rgba(0,128,255,.10), transparent 70%);
        background: radial-gradient(circle at center, rgba(0,128,255,.10), transparent 70%);
    }
    #msgs, #msgs-done {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        margin: 0;
        display: -webkit-box; display: -webkit-flex; display: flex;
        -webkit-box-align: center; -webkit-align-items: center; align-items: center;
        -webkit-box-pack: center; -webkit-justify-content: center; justify-content: center;
        padding: 0 12px;
        font-size: 22px;
        font-weight: 700;
        line-height: 1.5;
        word-break: break-all;
    }
    #msgs       { color: #6ca8d8; opacity: 1; }
    #msgs-done  {
        color: #4aa8ff;
        text-shadow: 0 0 16px rgba(0, 128, 255, .6);
        opacity: 0;
    }
    #msgs-wrap.done #msgs      { opacity: 0; }
    #msgs-wrap.done #msgs-done { opacity: 1; }

    /* ============================================================
       å³ä¾§ï¼šå¤š Tab æ’ä»¶èœå•ï¼ˆæ‰‹æŸ„ = ä¸€åˆ—ç«–æ’å°æ ‡ç­¾ï¼‰
       ============================================================ */
    #side-menu {
        position: fixed;
        top: 0;
        right: 0;
        width: 286px;
        height: 100vh;
        z-index: 2000;
        display: block;
        pointer-events: none;
        /* åˆå§‹å®Œå…¨éšè—ï¼ˆå«æ‰‹æŸ„ï¼‰ï¼›markDone åç”± JS æ”¹ä¸º translate(300px, 0) */
        -webkit-transform: translate(286px, 0);
        transform: translate(286px, 0);
        -webkit-transition: -webkit-transform .35s cubic-bezier(.22, .61, .36, 1);
        transition: transform .35s cubic-bezier(.22, .61, .36, 1);
    }

    /* ---- æ‰‹æŸ„ï¼šç«–æ’å°æ ‡ç­¾å®¹å™¨ ---- */
    #side-menu .side-handle {
        position: absolute;
        right: 240px;
        top: 50%;
        -webkit-transform: translateY(-50%);
        transform: translateY(-50%);
        width: 46px;
        display: -webkit-box; display: -webkit-flex; display: flex;
        -webkit-box-orient: vertical; -webkit-flex-direction: column; flex-direction: column;
        -webkit-box-align: stretch; -webkit-align-items: stretch; align-items: stretch;
        pointer-events: auto;
    }

    /* ---- å•ä¸ªå°æ ‡ç­¾ ---- */
    #side-menu .handle-tab {
        width: 46px;
        min-height: 90px;
        margin-bottom: 6px;
        padding: 10px 0;
        background: #0a63c4;
        color: #fff;
        border-radius: 12px 0 0 12px;
        box-shadow: -4px 0 14px rgba(0, 128, 255, .45);
        cursor: pointer;
        display: -webkit-box; display: -webkit-flex; display: flex;
        -webkit-box-align: center; -webkit-align-items: center; align-items: center;
        -webkit-box-pack: center; -webkit-justify-content: center; justify-content: center;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 4px;
        line-height: 1;
        -webkit-writing-mode: vertical-rl;
        writing-mode: vertical-rl;
        -webkit-text-orientation: upright;
        text-orientation: upright;
        -webkit-user-select: none; user-select: none;
        -webkit-tap-highlight-color: transparent;
        -webkit-transition: background .2s, box-shadow .2s;
        transition: background .2s, box-shadow .2s;
    }
    #side-menu .handle-tab:last-child { margin-bottom: 0; }
    #side-menu .handle-tab.y2jb {
        background: #007a63;
        box-shadow: -4px 0 14px rgba(0, 184, 148, .45);
    }
    #side-menu .handle-tab:hover {
        box-shadow: -6px 0 20px rgba(0, 128, 255, .8);
    }

    /* ---- é¢æ¿ ---- */
    #side-menu .side-panel {
    position: absolute;
    right: 0;
    top: 50%;
    width: 240px;
    height: 80vh;               /* â† æŠŠ max-height æ”¹æˆ height */
    -webkit-transform: translateY(-50%);
    transform: translateY(-50%);
    pointer-events: auto;
    background: -webkit-linear-gradient(top, #0a121e, #050a10);
    background: linear-gradient(180deg, #0a121e, #050a10);
    padding: 10px;

    /* æ–°å¢ï¼šflex åˆ—å¸ƒå±€ */
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-orient: vertical;
    -webkit-flex-direction: column;
    flex-direction: column;

    overflow: hidden;           /* â† è®©å†…éƒ¨å„è‡ªæ»šåŠ¨ */
    border-left: 1px solid rgba(0, 128, 255, .5);
    border-radius: 14px 0 0 14px;
    box-shadow: -8px 0 24px rgba(0, 128, 255, .4);
}

    .side-title {
        flex: 0 0 auto; 
        color: #fff;
        font-size: 16px;
        font-weight: 700;
        letter-spacing: 2px;
        background: -webkit-linear-gradient(left, #0080FF, #005AB5);
        background: linear-gradient(90deg, #0080FF, #005AB5);
        padding: 10px;
        border-radius: 10px;
        margin: 0 0 10px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0, 128, 255, .4);
    }

    #side-pages {
        position: relative;
        overflow: hidden;
        -webkit-box-flex: 1;        /* æ–°å¢ */
        -webkit-flex: 1 1 auto;     /* æ–°å¢ */
        flex: 1 1 auto;
    }
    
    /* ---- å†…å®¹é¡µï¼ˆdisplay ç”± JS æ§åˆ¶ï¼‰ ---- */
    .tab-page {
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
    }

    /* ---- payload å¡ç‰‡ ---- */
    .tab-page .side-item {
        position: relative;
        cursor: pointer;
        background: -webkit-linear-gradient(135deg, #0d1b2c, #0a1520);
        background: linear-gradient(135deg, #0d1b2c, #0a1520);
        border: 1px solid rgba(0, 128, 255, .35);
        border-radius: 10px;
        padding: 10px 12px 10px 16px;
        margin-bottom: 8px;
        text-align: left;
        -webkit-transition: box-shadow .2s, border-color .2s, -webkit-transform .15s;
        transition: box-shadow .2s, border-color .2s, transform .15s;
        overflow: hidden;
    }
    .tab-page .side-item:last-child { margin-bottom: 0; }
    .tab-page .side-item::before {
        content: '';
        position: absolute;
        left: 0; top: 0; bottom: 0;
        width: 3px;
        background: -webkit-linear-gradient(top, #4aa8ff, #0080FF);
        background: linear-gradient(180deg, #4aa8ff, #0080FF);
    }
    .tab-page.y2jb .side-item::before {
        background: -webkit-linear-gradient(top, #26d0a8, #00b894);
        background: linear-gradient(180deg, #26d0a8, #00b894);
    }
    .tab-page .side-item:hover {
        border-color: #4aa8ff;
        box-shadow: 0 0 14px rgba(0, 128, 255, .55);
        -webkit-transform: translateX(-2px);
        transform: translateX(-2px);
    }
    .tab-page .side-item:active {
        -webkit-transform: scale(.98);
        transform: scale(.98);
    }
    .tab-page .side-item .t {
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        margin: 0;
        letter-spacing: .5px;
    }
    .tab-page .side-item .d {
        color: #9fc0dd;
        font-size: 13px;
        margin: 4px 0 0;
        line-height: 1.35;
    }
    .tab-page .side-item .i {
        color: #647a91;
        font-size: 11px;
        margin: 6px 0 0;
        font-family: monospace;
    }

    /* ============ Footer ============ */
    #footer {
        flex: 0 0 auto;
        text-align: center;
        padding: 8px 10px 12px;
        font-size: 13px;
        color: #b8b8b8;
        line-height: 1.5;
        position: relative;
    }
    #footer a { color: #4aa8ff; text-decoration: none; }
    #footer hr { border: none; border-top: 1px solid #333; margin: 8px 0; }
    #version { color: #9aa7b3; font-size: 13px; margin: 2px 0; }

    .l2-redirect-box {
        display: inline-block;
        background: var(--mainColor);
        color: #000;
        font-weight: 700;
        padding: 2px 10px;
        border-radius: 6px;
        margin-right: 6px;
        font-size: 12px;
    }
    </style>
</head>

<body>
    <!-- é¡¶æ  -->
    <div id="top">
        <div id="webname">PS5 æŠ˜è…¾ç½‘ç«™ by Zerofo</div>
        <p id="top-bar-text">
            Current firmware: <span class="fw-bold" id="current-fw">unknown</span>
        </p>
        <div id="toast-container">
            <div id="toast"></div>
        </div>
    </div>

    <!-- ä¸»è§†å›¾ -->
    <div id="main-content">
        <!-- <div id="pre-jb-view" class="selected">
            <a tabindex="0" class="btn" id="run-jb" aria-disabled="true">ä¸€é”®æŠ˜è…¾</a>
            <a tabindex="0" class="btn" id="run-wk-only" aria-disabled="true">Webkit-only (å‘é€æ’ä»¶)</a>
        </div> -->

        <div id="console-view">
            <div class="terminaltitle">Terminal</div>
            <div id="console" class="log"></div>
        </div>
    </div>

    <!-- åº•éƒ¨ msg æ¡ -->
    <div id="msgs-wrap">
        <h2 id="msgs"></h2>
        <h2 id="msgs-done">æŠ˜è…¾å®Œæˆ Â· ç‚¹å³ä¾§æ’ä»¶èœå•å‘å°„ payload</h2>
    </div>

    <!-- ============ å³ä¾§ï¼šå¤š Tab æ’ä»¶èœå• ============ -->
    <div id="side-menu">
        <!-- æ‰‹æŸ„ = ä¸€åˆ—ç«–æ’å°æ ‡ç­¾ï¼ˆY2JB / é€šç”¨ 1 / é€šç”¨ 2 â€¦ï¼‰ï¼Œç”± JS å¡«å…… -->
        <div class="side-handle" id="side-handle"></div>

        <div class="side-panel">
            <div class="side-title">æ’ä»¶èœå•</div>
            <div id="side-pages"></div>
        </div>
    </div>

    <!-- Footer -->
    <div id="footer">
        <p id="version">v1.3</p>
        <p style="margin:2px 0;">
            æ ¸å¿ƒæ¥è‡ª:
            <a href="https://github.com/ufm42">@ufm42</a>,
            <a href="https://github.com/shahrilnet">@shahrilnet</a>,
            <a href="https://github.com/n0llptr">@n0llptr</a>,
            <a href="https://x.com/fail0verflow">@fail0verflow</a>,
            <a href="https://twitter.com/flat_z">@flat_z</a>,
            <a href="https://twitter.com/SpecterDev">@SpecterDev</a>,
            ChendoChap, idlesauce,
            <a href="https://twitter.com/SocraticBliss">@SocraticBliss</a>,
            <a href="https://github.com/john-tornblom">John Tornblom</a>
        </p>
        <div style="text-align:left; margin-top:6px;">
            <span class="l2-redirect-box">L2</span><span>Redirect</span>
        </div>
    </div>

    <script src="src/main.js"></script>

    <script>
        const MAX_LOG_NODES = 150;
        let logScrollPending = false;
        let hostConsoleElem = null;
        let hostLastLogIsTemp = false;

        if (typeof LogLevel === "undefined") {
            var LogLevel = {
                DEBUG: 0, INFO: 1, LOG: 2, WARN: 3, ERROR: 4, SUCCESS: 5,
                FLAG_TEMP: 0x1000
            };
        }

        function log(string, level) {
            if (hostConsoleElem === null) {
                hostConsoleElem = document.getElementById("console");
            }
            const isTemp = level & LogLevel.FLAG_TEMP;
            level = level & ~LogLevel.FLAG_TEMP;
            const elemClass = ["LOG-DEBUG","LOG-INFO","LOG-LOG","LOG-WARN","LOG-ERROR","LOG-SUCCESS"][level];
            const text = "[" + window.fw_str + "] " + string;

            if (isTemp && hostLastLogIsTemp) {
                const lastChild = hostConsoleElem.lastChild;
                if (lastChild) { lastChild.innerText = text; lastChild.className = elemClass; }
                return;
            } else if (isTemp) { hostLastLogIsTemp = true; } else { hostLastLogIsTemp = false; }

            const logElem = document.createElement("div");
            logElem.innerText = text;
            logElem.className = elemClass;
            hostConsoleElem.appendChild(logElem);
            while (hostConsoleElem.childNodes.length > MAX_LOG_NODES)
                hostConsoleElem.removeChild(hostConsoleElem.firstChild);

            if (!logScrollPending) {
                logScrollPending = true;
                requestAnimationFrame(function () {
                    logScrollPending = false;
                    hostConsoleElem.scrollTop = hostConsoleElem.scrollHeight;
                });
            }
        }

        addEventListener("unhandledrejection", (event) => {
            const reason = event.reason;
            alert(`${reason}\n${reason.sourceURL}:${reason.line}:${reason.column}\n${reason.stack}`);
            throw reason;
        });

        const SESSIONSTORE_ON_LOAD_AUTORUN_KEY = "on_load_autorun";
        window.SESSIONSTORE_ON_LOAD_AUTORUN_KEY = SESSIONSTORE_ON_LOAD_AUTORUN_KEY;
    </script>
